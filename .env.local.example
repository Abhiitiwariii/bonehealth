# Supabase cloud sync (optional — the app works fully on-device without it).
#
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project: Dashboard → Project Settings → API.
#
#   Project URL   -> NEXT_PUBLIC_SUPABASE_URL
#   anon public   -> NEXT_PUBLIC_SUPABASE_ANON_KEY   (the "anon"/"public" key, NOT service_role)
#
# Both are the PUBLIC keys and safe to ship in a client bundle; per-user Row
# Level Security (see supabase/002_per_user_auth.sql) is what protects the data.
# Never put the service_role key here — it bypasses RLS.
#
# Before sync does anything, also:
#   1. Authentication → Providers → Anonymous → ON
#   2. Run supabase/schema.sql, then supabase/002_per_user_auth.sql in the SQL Editor
#
# Restart `npm run dev` after editing this file — Next.js reads env at boot.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
